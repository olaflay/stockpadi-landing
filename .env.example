# OjàPadi Landing Page Environment Variables
# All links, URLs, and contacts are dynamic and driven by these variables.

# Base Public Landing Page URL (leave blank to automatically infer from browser window.location.origin)
VITE_SITE_URL=

# Main Web App (POS) URL (e.g. http://localhost:3000 or https://app.example.com)
VITE_WEB_APP_URL=http://localhost:3000

# Business / Platform Brand Name
VITE_BUSINESS_NAME=OjaPadi

# Support Contact
VITE_WHATSAPP_NUMBER=
VITE_SUPPORT_EMAIL=support@example.com

# Social Links (optional - icons only render if configured)
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_TIKTOK=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_TWITTER=
